// toast.effect - one Windows-style notification card (XP / Vista-7 balloon,
// Windows 8, 10 and 11), drawn analytically.  The message text is a
// pre-rendered texture; the type icon (heart, star, coin, chat, info) is
// drawn here from signed-distance shapes.  All colour maths is in sRGB space.

uniform float4x4 ViewProj;
uniform texture2d text_tex;

uniform float2 quad_size;     // whole quad in px (card + shadow margin)
uniform float4 card;          // x y w h of the card inside the quad
uniform int    style;         // 0 XP balloon, 1 Vista/7 balloon, 2 Win8, 3 Win10, 4 Win11
uniform float  alpha;
uniform int    kind;          // 0 info, 1 follow, 2 sub, 3 donation, 4 chat
uniform int    dark;
uniform float4 accent;
uniform float2 text_pos;      // top-left of the text texture, quad px
uniform float2 text_size;
uniform float3 icon;          // x y size (quad px)
uniform float  ui;
uniform int    tail;          // balloon tail (styles 0,1)

sampler_state linear_clamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float cov(float d)
{
	return saturate(0.5 - d);
}

float sdBox(float2 p, float2 b, float r)
{
	float2 q = abs(p) - b + r;
	return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

float sdSeg(float2 p, float2 a, float2 b)
{
	float2 pa = p - a;
	float2 ba = b - a;
	float h = saturate(dot(pa, ba) / dot(ba, ba));
	return length(pa - ba * h);
}

float4 over(float4 src, float4 dst)
{
	float a = src.a + dst.a * (1.0 - src.a);
	float3 c = (src.rgb * src.a + dst.rgb * dst.a * (1.0 - src.a)) / max(a, 1e-5);
	return float4(c, a);
}

// iq's 5-point star
float sdStar5(float2 p, float r, float rf)
{
	float2 k1 = float2(0.809016994375, -0.587785252292);
	float2 k2 = float2(-k1.x, k1.y);
	p.x = abs(p.x);
	p -= 2.0 * max(dot(k1, p), 0.0) * k1;
	p -= 2.0 * max(dot(k2, p), 0.0) * k2;
	p.x = abs(p.x);
	p.y -= r;
	float2 ba = rf * float2(-k1.y, k1.x) - float2(0, 1);
	float h = clamp(dot(p, ba) / dot(ba, ba), 0.0, r);
	return length(p - ba * h) * sign(p.y * ba.x - p.x * ba.y);
}

// ---- type icons: q in px inside a size x size box, returns straight colour + alpha
float4 type_icon(int k, float2 q, float size)
{
	float2 c = (q - size * 0.5) / (size * 0.5);      // -1..1, y down
	float px = 1.0 / (size * 0.5);                    // one pixel in c units
	float4 o = float4(0, 0, 0, 0);

	if (k == 1) {                                     // heart
		float2 q = float2(abs(c.x) * 0.78, -c.y * 0.78 + 0.62);
		float d;
		if (q.y + q.x > 1.0) {
			float2 e = q - float2(0.25, 0.75);
			d = sqrt(dot(e, e)) - 0.35355;
		} else {
			float2 e1 = q - float2(0.0, 1.0);
			float2 e2 = q - 0.5 * max(q.x + q.y, 0.0);
			d = sqrt(min(dot(e1, e1), dot(e2, e2))) * sign(q.x - q.y);
		}
		float cv = saturate(0.5 - d / (px * 0.78));
		float3 col = lerp(float3(1.0, 0.45, 0.55), float3(0.86, 0.15, 0.32), saturate(c.y * 0.5 + 0.5));
		o = float4(col, cv);
	} else if (k == 2) {                              // star
		float d = sdStar5(float2(c.x, -c.y + 0.05) * 1.05, 0.95, 0.42);
		float3 col = lerp(float3(1.0, 0.86, 0.35), float3(0.98, 0.64, 0.05), saturate(c.y * 0.5 + 0.5));
		o = float4(col, saturate(0.5 - d / px));
	} else if (k == 3) {                              // coin with a "$"
		float d = length(c) - 0.92;
		float3 col = lerp(float3(1.0, 0.86, 0.32), float3(0.90, 0.60, 0.10), saturate(length(c - float2(-0.3, -0.3)) * 0.8));
		o = float4(col, saturate(0.5 - d / px));
		float rim = saturate(0.5 - abs(d + 0.10) / px * 0.5);
		o.rgb = lerp(o.rgb, float3(0.70, 0.42, 0.05), rim * 0.55);
		float2 s = c * 1.25;
		float w = 0.16;
		float d1 = abs(length(s - float2(0.0, -0.36)) - 0.30) - w * 0.5;
		float d2 = abs(length(s - float2(0.0, 0.36)) - 0.30) - w * 0.5;
		bool up_ok = !(s.x > 0.0 && s.y > -0.36);
		bool dn_ok = !(s.x < 0.0 && s.y < 0.36);
		float glyph = min(up_ok ? d1 : 9.0, dn_ok ? d2 : 9.0);
		glyph = min(glyph, sdSeg(s, float2(0.0, -0.78), float2(0.0, 0.78)) - w * 0.22);
		o.rgb = lerp(o.rgb, float3(0.55, 0.32, 0.02), saturate(0.5 - glyph / px * 0.7) * o.a);
	} else if (k == 4) {                              // chat bubble
		float d = sdBox(c - float2(0.0, -0.10), float2(0.86, 0.55), 0.35);
		float tailv = 9.0;
		{
			float2 a = float2(-0.55, 0.30);
			float2 b = float2(-0.20, 0.30);
			float2 t = float2(-0.62, 0.86);
			// distance to the triangle a-b-t (inside negative)
			float2 e0 = b - a, e1 = t - b, e2 = a - t;
			float2 v0 = c - a, v1 = c - b, v2 = c - t;
			float2 p0 = v0 - e0 * saturate(dot(v0, e0) / dot(e0, e0));
			float2 p1 = v1 - e1 * saturate(dot(v1, e1) / dot(e1, e1));
			float2 p2 = v2 - e2 * saturate(dot(v2, e2) / dot(e2, e2));
			float s = sign(e0.x * e2.y - e0.y * e2.x);
			float2 dd = min(min(float2(dot(p0, p0), s * (v0.x * e0.y - v0.y * e0.x)),
					    float2(dot(p1, p1), s * (v1.x * e1.y - v1.y * e1.x))),
					float2(dot(p2, p2), s * (v2.x * e2.y - v2.y * e2.x)));
			tailv = -sqrt(dd.x) * sign(dd.y);
		}
		float dcomb = min(d, tailv);
		float3 col = lerp(float3(0.45, 0.72, 1.0), float3(0.15, 0.48, 0.90), saturate(c.y * 0.5 + 0.5));
		o = float4(col, saturate(0.5 - dcomb / px));
		float dots = min(length(c - float2(-0.36, -0.10)), min(length(c - float2(0.0, -0.10)), length(c - float2(0.36, -0.10)))) - 0.12;
		o.rgb = lerp(o.rgb, float3(1, 1, 1), saturate(0.5 - dots / px) * o.a);
	} else {                                          // info: blue disc with an "i"
		float d = length(c) - 0.92;
		float3 col = lerp(float3(0.36, 0.66, 1.0), float3(0.10, 0.42, 0.85), saturate(c.y * 0.5 + 0.5));
		o = float4(col, saturate(0.5 - d / px));
		float dotd = length(c - float2(0.0, -0.42)) - 0.13;
		float bar = sdBox(c - float2(0.0, 0.16), float2(0.11, 0.36), 0.05);
		o.rgb = lerp(o.rgb, float3(1, 1, 1), saturate(0.5 - min(dotd, bar) / px) * o.a);
	}
	return o;
}

// Windows 9x bevel (raised window face)
float3 bevel95(float2 p, float4 r, float3 face, float b)
{
	float2 l = p - r.xy;
	float dl = l.x, dt = l.y, dr = r.z - l.x, db = r.w - l.y;
	if (dr < b || db < b) return float3(0, 0, 0);
	if (dl < b || dt < b) return float3(1, 1, 1);
	if (dr < 2.0 * b || db < 2.0 * b) return float3(0.5, 0.5, 0.5);
	if (dl < 2.0 * b || dt < 2.0 * b) return float3(0.875, 0.875, 0.875);
	return face;
}

// point-in-triangle style tail for balloons: apex below the card
float tail_dist(float2 p, float2 a, float2 b, float2 apex)
{
	float2 e0 = b - a, e1 = apex - b, e2 = a - apex;
	float2 v0 = p - a, v1 = p - b, v2 = p - apex;
	float2 p0 = v0 - e0 * saturate(dot(v0, e0) / dot(e0, e0));
	float2 p1 = v1 - e1 * saturate(dot(v1, e1) / dot(e1, e1));
	float2 p2 = v2 - e2 * saturate(dot(v2, e2) / dot(e2, e2));
	float s = sign(e0.x * e2.y - e0.y * e2.x);
	float2 d = min(min(float2(dot(p0, p0), s * (v0.x * e0.y - v0.y * e0.x)),
			   float2(dot(p1, p1), s * (v1.x * e1.y - v1.y * e1.x))),
		       float2(dot(p2, p2), s * (v2.x * e2.y - v2.y * e2.x)));
	return -sqrt(d.x) * sign(d.y);
}

float4 PSToast(VertData v_in) : TARGET
{
	float2 p = v_in.uv * quad_size;
	float2 cc = card.xy + card.zw * 0.5;
	float2 ch = card.zw * 0.5;

	float rad = (style == 0) ? 8.0 * ui : ((style == 1) ? 6.0 * ui : ((style == 4) ? 8.0 * ui : 0.0));
	float bpx = max(1.0, floor(ui + 0.5));
	float d = sdBox(p - cc, ch, rad);

	// balloon tail (XP / Vista-7): small triangle under the right side of the card
	float dtail = 9999.0;
	if (tail != 0) {
		float bx = card.x + card.z - 46.0 * ui;
		dtail = tail_dist(p, float2(bx, card.y + card.w - 1.0), float2(bx + 22.0 * ui, card.y + card.w - 1.0),
				  float2(bx + 8.0 * ui, card.y + card.w + 14.0 * ui));
	}
	float dshape = min(d, dtail);

	float4 out_col = float4(0, 0, 0, 0);

	// ---- shadow
	float sh_r = (style >= 3) ? 14.0 * ui : 9.0 * ui;
	float sh = 1.0 - smoothstep(-sh_r * 0.3, sh_r, sdBox(p - cc - float2(0, 4.0 * ui), ch, rad));
	float sh_a = ((style >= 3) ? 0.42 : 0.30) * sh;
	if (style >= 5)
		sh_a = 0.38 * cov(sdBox(p - cc - float2(3.0, 3.0) * ui, ch, 0.0));
	out_col = float4(0, 0, 0, sh_a);

	// ---- fill
	float4 fill;
	float3 border = float3(0, 0, 0);
	float border_a = 0.0;
	if (style == 0) {
		fill = float4(1.0, 1.0, 0.882, 1.0);
		border = float3(0, 0, 0);
		border_a = 1.0;
	} else if (style == 1) {
		float t = saturate((p.y - card.y) / card.w);
		fill = float4(lerp(float3(0.96, 0.975, 0.995), float3(0.86, 0.90, 0.95), saturate((p.y - card.y) / max(card.w, 1.0))), 1.0);
		border = float3(0.43, 0.50, 0.60);
		border_a = 1.0;
	} else if (style == 2) {
		fill = float4(accent.rgb, 1.0);
		border = float3(1, 1, 1);
		border_a = 0.25;
	} else if (style == 3) {
		fill = (dark != 0) ? float4(0.122, 0.122, 0.122, 0.97) : float4(0.949, 0.949, 0.949, 0.97);
		border = (dark != 0) ? float3(1, 1, 1) : float3(0, 0, 0);
		border_a = 0.14;
	} else if (style == 5) {
		float3 bv = bevel95(p, card, float3(0.753, 0.753, 0.753), bpx);
		fill = float4(bv, 1.0);
		// blue title bar with the app name
		float2 l = p - card.xy;
		float th = 22.0 * ui;
		if (l.x > 3.0 * bpx && l.x < card.z - 3.0 * bpx && l.y > 3.0 * bpx && l.y < 3.0 * bpx + th) {
			float g = saturate((l.x - 3.0 * bpx) / (card.z - 6.0 * bpx));
			fill.rgb = lerp(float3(0.0, 0.0, 0.502), float3(0.063, 0.518, 0.816), g);
		}
		border_a = 0.0;
	} else if (style == 6) {
		fill = float4(1.0, 1.0, 0.882, 1.0);
		border = float3(0, 0, 0);
		border_a = 1.0;
	} else {
		fill = (dark != 0) ? float4(0.173, 0.173, 0.173, 0.96) : float4(0.976, 0.976, 0.976, 0.96);
		border = (dark != 0) ? float3(1, 1, 1) : float3(0, 0, 0);
		border_a = 0.10;
	}
	out_col = over(float4(fill.rgb, fill.a * cov(dshape)), out_col);
	float ring = cov(abs(dshape + 0.5) - 0.5);
	out_col = over(float4(border, border_a * ring), out_col);

	// ---- type icon
	if (icon.z > 0.0) {
		float2 iq = p - icon.xy;
		if (iq.x >= 0.0 && iq.y >= 0.0 && iq.x < icon.z && iq.y < icon.z) {
			float4 ic = type_icon(kind, iq, icon.z);
			if (style == 2)
				ic.rgb = lerp(ic.rgb, float3(1, 1, 1), 0.85);
			out_col = over(ic, out_col);
		}
	}

	// ---- balloon close "x" (XP / Vista-7)
	if (style <= 1) {
		float2 xc = float2(card.x + card.z - 12.0 * ui, card.y + 12.0 * ui);
		float2 xq = p - xc;
		float xd = min(sdSeg(xq, float2(-3.5, -3.5) * ui, float2(3.5, 3.5) * ui),
			       sdSeg(xq, float2(-3.5, 3.5) * ui, float2(3.5, -3.5) * ui)) - 0.6 * ui;
		out_col = over(float4(0.25, 0.25, 0.25, cov(xd)), out_col);
	}

	// ---- text (already coloured)
	float2 tq = p - text_pos;
	if (tq.x >= 0.0 && tq.y >= 0.0 && tq.x < text_size.x && tq.y < text_size.y) {
		float4 t = text_tex.Sample(linear_clamp, tq / text_size);
		out_col = over(t, out_col);
	}

	out_col.a *= alpha;
	return out_col;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSToast(v_in);
	}
}
